@model PagoReversionAplicacionViewModel

@{
    ViewData["Title"] = "Revertir aplicación de pago";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-8">
        <h1 class="h3 fw-bold mb-3" style="color: var(--azul-rey);">Revertir aplicación</h1>
        <div class="alert alert-warning">
            El valor aplicado volverá a quedar disponible como anticipo. El total recibido del pago no cambiará.
        </div>
        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row mb-4">
                    <dt class="col-sm-4">Recibo</dt><dd class="col-sm-8">@Model.Recibo</dd>
                    <dt class="col-sm-4">Factura</dt><dd class="col-sm-8">@Model.FacturaId</dd>
                    <dt class="col-sm-4">Valor aplicado</dt><dd class="col-sm-8">$@Model.ValorAplicado.ToString("N2")</dd>
                </dl>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Motivo" class="form-label"></label>
                        <textarea asp-for="Motivo" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Motivo" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Confirmar reversión</button>
                        <a asp-action="Detalle" asp-route-pagoId="@Model.PagoId" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
