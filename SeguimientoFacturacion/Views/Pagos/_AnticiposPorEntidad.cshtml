@using SeguimientoFacturacion.Application.DTOs.Pagos
@model IReadOnlyList<AnticipoEntidadResumenDto>

@{
    var totalAnticipos = Model.Sum(entidad => entidad.AnticipoDisponible);
}

<div class="modal-header">
    <div>
        <h2 class="modal-title h5 mb-1 fw-bold" style="color: var(--azul-rey);">
            Anticipos por entidad
        </h2>
        <div class="small text-secondary">
            Anticipo total disponible: <strong>$@totalAnticipos.ToString("N2")</strong>
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
</div>

<div class="modal-body">
    @if (Model.Count == 0)
    {
        <div class="text-center text-secondary py-5">
            <i class="bi bi-wallet2 d-block mb-2" style="font-size: 2.5rem;"></i>
            No existen anticipos disponibles.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Entidad</th>
                        <th class="text-end">Facturas con anticipo</th>
                        <th class="text-end">Recibos</th>
                        <th class="text-end">Anticipo disponible</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entidad in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@entidad.Aseguradora</td>
                            <td class="text-end">@entidad.CantidadFacturasConAnticipo</td>
                            <td class="text-end">@entidad.CantidadRecibos</td>
                            <td class="text-end fw-bold text-primary">
                                $@entidad.AnticipoDisponible.ToString("N2")
                            </td>
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary js-ver-anticipos-entidad"
                                        data-url="@Url.Action("DetalleAnticiposEntidad", "Pagos", new { aseguradoraId = entidad.AseguradoraId })">
                                    Ver detalle
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
        Cerrar
    </button>
</div>
