@using SeguimientoFacturacion.Application.DTOs.Pagos
@model PagoGestionManualDto

@{
    ViewData["Title"] = "Pago registrado";
    var aplicacion = Model.Aplicaciones.Single();
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-9">
        <div class="alert alert-success d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3"></i>
            <div>
                El pago <strong>@Model.Recibo</strong> fue registrado
                correctamente.
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header fw-bold">
                Distribución financiera del pago
            </div>
            <div class="card-body">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="text-secondary small">Valor recibido</div>
                        <div class="fs-5 fw-bold">
                            $@Model.ValorPagado.ToString("N2")
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-secondary small">Aplicado a cartera</div>
                        <div class="fs-5 fw-bold text-success">
                            $@Model.TotalAplicado.ToString("N2")
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-secondary small">Anticipo</div>
                        <div class="fs-5 fw-bold text-warning">
                            $@Model.TotalAnticipo.ToString("N2")
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Factura</th>
                                <th class="text-end">Saldo anterior</th>
                                <th class="text-end">Recibido</th>
                                <th class="text-end">Aplicado</th>
                                <th class="text-end">Anticipo</th>
                                <th class="text-end">Saldo posterior</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold">@aplicacion.FacturaId</td>
                                <td class="text-end">
                                    $@aplicacion.SaldoAntes.ToString("N2")
                                </td>
                                <td class="text-end">
                                    $@aplicacion.ValorRecibido.ToString("N2")
                                </td>
                                <td class="text-end text-success">
                                    $@aplicacion.ValorAplicado.ToString("N2")
                                </td>
                                <td class="text-end text-warning">
                                    $@aplicacion.ValorAnticipo.ToString("N2")
                                </td>
                                <td class="text-end fw-bold">
                                    $@aplicacion.SaldoDespues.ToString("N2")
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <a asp-controller="Facturas"
                   asp-action="Index"
                   asp-route-textoBusqueda="@aplicacion.FacturaId"
                   class="btn btn-outline-secondary">
                    Volver a facturas
                </a>
                <a asp-action="Crear"
                   asp-route-facturaId="@aplicacion.FacturaId"
                   class="btn btn-primary">
                    Registrar otro pago
                </a>
            </div>
        </div>
    </div>
</div>
