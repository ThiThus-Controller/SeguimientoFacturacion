@using SeguimientoFacturacion.Application.DTOs.Pagos
@model PagoDetalleDto
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Detalle del pago";
    var puedeRevertir = (await AuthorizationService.AuthorizeAsync(
        User,
        null,
        SeguimientoFacturacion.Configurations.PoliticasAutorizacion.PagosRevertirAplicacion)).Succeeded;
    var puedeAplicarAnticipo = (await AuthorizationService.AuthorizeAsync(
        User,
        null,
        SeguimientoFacturacion.Configurations.PoliticasAutorizacion.PagosAplicarAnticipo)).Succeeded;
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-xl-11">
        @if (ViewData["Pagos.MensajeExito"] is string mensajeExito)
        {
            <div class="alert alert-success">@mensajeExito</div>
        }
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 border-bottom pb-3 gap-3">
            <div>
                <h1 class="h3 mb-1 fw-bold" style="color: var(--azul-rey);">
                    <i class="bi bi-receipt-cutoff me-2 text-secondary"></i>Pago @Model.Recibo
                </h1>
                <p class="text-secondary mb-0">
                    @Model.Aseguradora · @Model.FechaPago.ToString("yyyy-MM-dd")
                </p>
            </div>
            <a asp-action="General" class="btn btn-outline-secondary">
                Volver a la consulta
            </a>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card h-100"><div class="card-body">
                    <div class="text-secondary small">Valor recibido</div>
                    <div class="fs-4 fw-bold">$@Model.ValorPagado.ToString("N2")</div>
                </div></div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-success"><div class="card-body">
                    <div class="text-secondary small">Aplicado a cartera</div>
                    <div class="fs-4 fw-bold text-success">$@Model.TotalAplicado.ToString("N2")</div>
                </div></div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-warning"><div class="card-body">
                    <div class="text-secondary small">Anticipo</div>
                    <div class="fs-4 fw-bold text-warning">$@Model.TotalAnticipo.ToString("N2")</div>
                </div></div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold">Información del recibo</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3"><span class="text-secondary">Retención</span><div>$@Model.Retencion.ToString("N2")</div></div>
                    <div class="col-md-3"><span class="text-secondary">Rete ICA</span><div>$@Model.ReteIca.ToString("N2")</div></div>
                    <div class="col-md-6"><span class="text-secondary">Notas</span><div>@(Model.Notas ?? "—")</div></div>
                    <div class="col-md-6">
                        <span class="text-secondary">Creación</span>
                        <div>@Model.CreadoPor · @Model.FechaCreacionUtc.ToString("yyyy-MM-dd HH:mm") UTC</div>
                    </div>
                    <div class="col-md-6">
                        <span class="text-secondary">Última modificación</span>
                        <div>
                            @(Model.FechaModificacionUtc.HasValue
                                ? $"{Model.ModificadoPor} · {Model.FechaModificacionUtc.Value:yyyy-MM-dd HH:mm} UTC"
                                : "—")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Aplicaciones del pago</span>
                <span class="badge bg-primary rounded-pill">@Model.Aplicaciones.Count facturas</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Factura</th>
                            <th>Paciente</th>
                            <th class="text-end">Recibido</th>
                            <th class="text-end">Aplicado</th>
                            <th class="text-end">Anticipo</th>
                            <th>Auditoría</th>
                            <th class="text-center">Acciones</th>
                            <th class="text-center pe-3">Navegar</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var aplicacion in Model.Aplicaciones)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@aplicacion.FacturaId</td>
                            <td>
                                @aplicacion.NombrePaciente
                                <div class="small text-secondary">@aplicacion.NumeroDocumento</div>
                            </td>
                            <td class="text-end">$@aplicacion.ValorRecibido.ToString("N2")</td>
                            <td class="text-end text-success">$@aplicacion.ValorAplicado.ToString("N2")</td>
                            <td class="text-end text-warning">$@aplicacion.ValorAnticipo.ToString("N2")</td>
                            <td>
                                <div class="small">@aplicacion.CreadoPor</div>
                                <div class="small text-secondary">
                                    @aplicacion.FechaCreacionUtc.ToString("yyyy-MM-dd HH:mm") UTC
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    @if (puedeRevertir && aplicacion.ValorAplicado > 0)
                                    {
                                        <a asp-action="RevertirAplicacion"
                                           asp-route-pagoId="@Model.Id"
                                           asp-route-aplicacionId="@aplicacion.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Revertir aplicación">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </a>
                                    }
                                    @if (puedeAplicarAnticipo && aplicacion.ValorAnticipo > 0)
                                    {
                                        <a asp-action="AplicarAnticipo"
                                           asp-route-pagoId="@Model.Id"
                                           asp-route-aplicacionId="@aplicacion.Id"
                                           class="btn btn-sm btn-outline-success"
                                           title="Aplicar anticipo">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                            <td class="text-center pe-3">
                                <a asp-action="Crear"
                                   asp-route-facturaId="@aplicacion.FacturaId"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Abrir pagos de la factura">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
