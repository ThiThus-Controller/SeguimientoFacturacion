@using Microsoft.AspNetCore.Authorization
@using SeguimientoFacturacion.Application.DTOs.Importacion
@using SeguimientoFacturacion.Configurations
@using SeguimientoFacturacion.Domain.Constants
@using SeguimientoFacturacion.Domain.Enums
@model SeguimientoFacturacion.ViewModels.Importacion.AnalisisImportacionViewModel
@inject IAuthorizationService ServicioAutorizacion

@{
    ViewData["Title"] = "Importación masiva";
    var resultado = Model.Resultado;
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-11">
        <div class="mb-4">
            <h1 class="h2 mb-2">
                Importación masiva modular
            </h1>

            <p class="text-secondary mb-0">
                Seleccione el proceso y cargue la plantilla
                correspondiente.
            </p>
        </div>

        <div class="alert alert-info" role="alert">
            <strong>Etapa de análisis:</strong>
            el archivo se valida y sus datos se almacenan
            únicamente en staging. Todavía no se modifican
            las tablas definitivas de facturación y cartera.
        </div>

        @if (TempData["ErrorImportacion"] is string error)
        {
            <div class="alert alert-danger" role="alert">
                @error
            </div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">
                    Seleccionar plantilla
                </h2>
            </div>

            <div class="card-body">
                <form asp-controller="Importacion"
                      asp-action="Analizar"
                      method="post"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-lg-5">
                            <label asp-for="Tipo"
                                   class="form-label">
                            </label>

                            <select asp-for="Tipo"
                                    id="tipoImportacion"
                                    class="form-select">
                                <option value="">
                                    Seleccione un proceso
                                </option>

                                @if (Model.TiposPermitidos.Contains(
                                    TipoImportacion.Facturas))
                                {
                                    <option value="@((int)TipoImportacion.Facturas)"
                                            data-plantilla-url="@Url.Action("DescargarPlantilla", "Importacion", new { tipo = (int)TipoImportacion.Facturas })">
                                        Facturas y pacientes
                                    </option>
                                }

                                @if (Model.TiposPermitidos.Contains(
                                    TipoImportacion.NotasFactura))
                                {
                                    <option value="@((int)TipoImportacion.NotasFactura)"
                                            data-plantilla-url="@Url.Action("DescargarPlantilla", "Importacion", new { tipo = (int)TipoImportacion.NotasFactura })">
                                        Notas crédito y débito
                                    </option>
                                }

                                @if (Model.TiposPermitidos.Contains(
                                    TipoImportacion.Glosas))
                                {
                                    <option value="@((int)TipoImportacion.Glosas)"
                                            data-plantilla-url="@Url.Action("DescargarPlantilla", "Importacion", new { tipo = (int)TipoImportacion.Glosas })">
                                        Glosas y respuestas
                                    </option>
                                }

                                @if (Model.TiposPermitidos.Contains(
                                    TipoImportacion.Pagos))
                                {
                                    <option value="@((int)TipoImportacion.Pagos)"
                                            data-plantilla-url="@Url.Action("DescargarPlantilla", "Importacion", new { tipo = (int)TipoImportacion.Pagos })">
                                        Pagos y aplicaciones
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="Tipo"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12 col-lg-7">
                            <label asp-for="Archivo"
                                   class="form-label">
                            </label>

                            <input asp-for="Archivo"
                                   type="file"
                                   class="form-control"
                                   accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />

                            <span asp-validation-for="Archivo"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <div class="form-text mt-3">
                        Únicamente archivos XLSX. Tamaño
                        máximo: @Model.TamanoMaximoMegabytes MB.
                        El tipo seleccionado debe coincidir
                        con la estructura de la plantilla.
                    </div>

                    <div class="mt-3 d-flex flex-wrap gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Registrar y analizar archivo
                        </button>

                        <a id="descargarPlantilla"
                           class="btn btn-outline-success disabled"
                           href="#"
                           aria-disabled="true"
                           tabindex="-1">
                            Descargar formato seleccionado
                        </a>
                    </div>

                    <div class="form-text mt-2">
                        La plantilla descargada incluye notas
                        aclaratorias en sus encabezados y listas
                        desplegables para los estados cerrados.
                    </div>
                </form>
            </div>
        </div>

        @if (resultado is not null)
        {
            var puedeConfirmar =
                (await ServicioAutorizacion.AuthorizeAsync(
                    User,
                    PoliticasAutorizacion.ParaConfirmacion(
                        resultado.Tipo)))
                .Succeeded;

            var descripcionTipo = resultado.Tipo switch
            {
                TipoImportacion.Facturas => "facturas y pacientes",
                TipoImportacion.NotasFactura => "notas crédito y débito",
                TipoImportacion.Glosas => "glosas y respuestas",
                TipoImportacion.Pagos => "pagos y aplicaciones",
                _ => "importación"
            };

            var claseResultado =
                resultado.EsValido
                    ? "alert-success"
                    : "alert-danger";

            var textoResultado =
                resultado.EsValido
                    ? "El archivo superó el análisis y su staging fue preparado."
                    : "El archivo contiene errores que impiden confirmarlo.";

            <div class="alert @claseResultado"
                 role="alert">
                <strong>Resultado:</strong>
                @textoResultado
            </div>

            @if (resultado.PuedeConfirmarse && puedeConfirmar)
            {
                <div class="alert alert-warning"
                     role="alert">
                    <strong>Lote preparado:</strong>
                    los datos todavía no han sido trasladados
                    a las tablas definitivas. Revise los
                    indicadores antes de confirmar.

                    <form asp-controller="Importacion"
                          asp-action="ConfirmarLote"
                          method="post"
                          class="mt-3"
                          onsubmit="return confirm('¿Confirma que revisó el lote y desea autorizar su procesamiento?');">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="loteId"
                               value="@resultado.LoteId" />

                        <input type="hidden"
                               name="tipo"
                               value="@((int)resultado.Tipo)" />

                        <button type="submit"
                                class="btn btn-warning">
                            Confirmar lote de @descripcionTipo
                        </button>
                    </form>
                </div>
            }

            <div class="row g-3 mb-4">
                @foreach (var indicador in
                    resultado.Indicadores)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <div class="text-secondary small">
                                    @indicador.Etiqueta
                                </div>

                                <div class="fs-4 fw-semibold">
                                    @indicador.Valor
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h2 class="h5 mb-0">
                        Información del lote
                    </h2>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">
                            Identificador del lote
                        </dt>

                        <dd class="col-sm-8">
                            <code>@resultado.LoteId</code>
                        </dd>

                        <dt class="col-sm-4">
                            Tipo
                        </dt>

                        <dd class="col-sm-8">
                            @resultado.Tipo
                        </dd>

                        <dt class="col-sm-4">
                            Estado
                        </dt>

                        <dd class="col-sm-8">
                            @resultado.EstadoLote
                        </dd>

                        <dt class="col-sm-4">
                            Archivo
                        </dt>

                        <dd class="col-sm-8">
                            @resultado.NombreArchivo
                        </dd>

                        <dt class="col-sm-4">
                            Hojas
                        </dt>

                        <dd class="col-sm-8">
                            @if (resultado.HojasDetectadas.Count > 0)
                            {
                                @string.Join(
                                    ", ",
                                    resultado.HojasDetectadas)
                            }
                            else
                            {
                                <span>No detectadas</span>
                            }
                        </dd>

                        <dt class="col-sm-4">
                            Filas analizadas
                        </dt>

                        <dd class="col-sm-8">
                            @resultado.TotalFilasAnalizadas.ToString("N0")
                        </dd>

                        <dt class="col-sm-4">
                            Errores
                        </dt>

                        <dd class="col-sm-8">
                            @resultado.TotalErrores.ToString("N0")
                        </dd>

                        <dt class="col-sm-4">
                            Advertencias
                        </dt>

                        <dd class="col-sm-8">
                            @resultado.TotalAdvertencias.ToString("N0")
                        </dd>

                        <dt class="col-sm-4">
                            Catálogos sin mapear
                        </dt>

                        <dd class="col-sm-8">
                            @resultado.CatalogosNoMapeados.ToString("N0")
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h2 class="h5 mb-0">
                        Inconsistencias encontradas
                    </h2>
                </div>

                <div class="card-body p-0">
                    @if (resultado.Inconsistencias.Count == 0)
                    {
                        <div class="p-4 text-center text-success">
                            No se encontraron inconsistencias.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">
                                            Severidad
                                        </th>
                                        <th scope="col">
                                            Código
                                        </th>
                                        <th scope="col">
                                            Fila
                                        </th>
                                        <th scope="col">
                                            Columna
                                        </th>
                                        <th scope="col">
                                            Valor presentado
                                        </th>
                                        <th scope="col">
                                            Mensaje
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var inconsistencia in
                                        resultado.Inconsistencias
                                            .OrderByDescending(
                                                elemento =>
                                                    elemento.Severidad)
                                            .ThenBy(
                                                elemento =>
                                                    elemento.Fila))
                                    {
                                        var esError =
                                            inconsistencia.Severidad ==
                                            SeveridadInconsistenciaImportacion
                                                .Error;

                                        var claseSeveridad =
                                            esError
                                                ? "text-bg-danger"
                                                : "text-bg-warning";

                                        var textoSeveridad =
                                            esError
                                                ? "Error"
                                                : "Advertencia";

                                        <tr>
                                            <td>
                                                <span class="badge @claseSeveridad">
                                                    @textoSeveridad
                                                </span>
                                            </td>

                                            <td>
                                                <code>
                                                    @inconsistencia.Codigo
                                                </code>
                                            </td>

                                            <td>
                                                @(inconsistencia.Fila
                                                    ?.ToString() ?? "—")
                                            </td>

                                            <td>
                                                @(inconsistencia.Columna
                                                    ?? "—")
                                            </td>

                                            <td>
                                                @(inconsistencia
                                                    .ValorPresentado
                                                    ?? "—")
                                            </td>

                                            <td>
                                                @inconsistencia.Mensaje
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts
{
    <script>
        (() => {
            const selector = document.getElementById(
                "tipoImportacion");
            const enlace = document.getElementById(
                "descargarPlantilla");

            if (!selector || !enlace) {
                return;
            }

            const actualizarEnlace = () => {
                const opcion =
                    selector.options[selector.selectedIndex];
                const url = opcion?.dataset.plantillaUrl;
                const habilitado = Boolean(url);

                enlace.href = habilitado ? url : "#";
                enlace.classList.toggle(
                    "disabled",
                    !habilitado);
                enlace.setAttribute(
                    "aria-disabled",
                    String(!habilitado));
                enlace.tabIndex = habilitado ? 0 : -1;
            };

            selector.addEventListener(
                "change",
                actualizarEnlace);

            actualizarEnlace();
        })();
    </script>
}
