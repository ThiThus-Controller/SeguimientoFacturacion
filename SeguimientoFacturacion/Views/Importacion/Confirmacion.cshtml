@using Microsoft.AspNetCore.Authorization
@using SeguimientoFacturacion.Configurations
@using SeguimientoFacturacion.Domain.Constants
@model SeguimientoFacturacion.ViewModels.Importacion.ConfirmacionLoteImportacionViewModel
@inject IAuthorizationService ServicioAutorizacion

@{
    ViewData["Title"] = "Lote confirmado";

    var puedeProcesarNotas =
        Model.Tipo == TipoImportacion.NotasFactura &&
        (await ServicioAutorizacion.AuthorizeAsync(
            User,
            PoliticasAutorizacion.ProcesarNotasFactura))
        .Succeeded;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="alert alert-success" role="alert">
            <h1 class="h4 alert-heading">
                Lote confirmado correctamente
            </h1>

            <p class="mb-0">
                El lote quedó autorizado para su procesamiento
                definitivo.
            </p>
        </div>

        <div class="alert alert-warning" role="alert">
            <strong>Importante:</strong>
            confirmar el lote no traslada todavía sus registros
            a las tablas definitivas. El traslado exige una segunda
            autorización de procesamiento.
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">
                    Información de la confirmación
                </h2>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">
                        Identificador del lote
                    </dt>

                    <dd class="col-sm-7">
                        <code>@Model.LoteId</code>
                    </dd>

                    <dt class="col-sm-5">
                        Tipo
                    </dt>

                    <dd class="col-sm-7">
                        @Model.TipoDescripcion
                    </dd>

                    <dt class="col-sm-5">
                        Estado
                    </dt>

                    <dd class="col-sm-7">
                        @Model.Estado
                    </dd>

                    <dt class="col-sm-5">
                        Confirmado por
                    </dt>

                    <dd class="col-sm-7">
                        @Model.ConfirmadoPor
                    </dd>

                    <dt class="col-sm-5">
                        Fecha de confirmación UTC
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.FechaConfirmacionUtc.ToString(
                            "yyyy-MM-dd HH:mm:ss 'UTC'"))
                    </dd>
                </dl>
            </div>
        </div>

        <div class="mt-4">
            @if (Model.Tipo == TipoImportacion.Facturas &&
                User.TienePermiso(
                    PermisosSistema.Facturas.Procesar))
            {
                <a asp-controller="Importacion"
                   asp-action="PrepararProcesamientoFacturas"
                   asp-route-loteId="@Model.LoteId"
                   class="btn btn-danger">
                    Continuar al procesamiento definitivo
                </a>
            }
            else if (puedeProcesarNotas)
            {
                <a asp-controller="Importacion"
                   asp-action="PrepararProcesamientoNotasFactura"
                   asp-route-loteId="@Model.LoteId"
                   class="btn btn-danger">
                    Procesar notas definitivamente
                </a>
            }
            else if (Model.Tipo != TipoImportacion.Facturas)
            {
                <span class="text-secondary me-2">
                    El lote quedó listo para su procesamiento
                    definitivo en el módulo correspondiente.
                </span>
            }
            else
            {
                <span class="text-secondary me-2">
                    El lote debe ser procesado por un usuario
                    autorizado.
                </span>
            }

            <a asp-controller="Importacion"
               asp-action="Index"
               class="btn btn-outline-primary ms-2">
                Volver a importaciones
            </a>
        </div>
    </div>
</div>
