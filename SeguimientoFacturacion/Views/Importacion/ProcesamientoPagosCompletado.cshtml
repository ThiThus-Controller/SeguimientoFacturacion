@model SeguimientoFacturacion.ViewModels.Importacion.ResultadoProcesamientoLotePagosViewModel

@{
    ViewData["Title"] = "Pagos importados";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="alert alert-success" role="alert">
            <h1 class="h4 alert-heading">
                Procesamiento de pagos completado
            </h1>
            <p class="mb-0">
                Los pagos y sus aplicaciones fueron trasladados
                a las tablas definitivas y el staging fue liberado.
            </p>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="text-secondary small">
                            Pagos importados
                        </div>
                        <div class="fs-4 fw-semibold">
                            @Model.TotalPagosImportados.ToString("N0")
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="text-secondary small">
                            Aplicaciones importadas
                        </div>
                        <div class="fs-4 fw-semibold">
                            @Model.TotalAplicacionesImportadas.ToString("N0")
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="text-secondary small">
                            Valor pagado importado
                        </div>
                        <div class="fs-4 fw-semibold">
                            @Model.ValorTotalPagadoImportado.ToString("C0")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">Resultado definitivo</h2>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Lote</dt>
                    <dd class="col-sm-7"><code>@Model.LoteId</code></dd>

                    <dt class="col-sm-5">Estado</dt>
                    <dd class="col-sm-7">@Model.Estado</dd>

                    <dt class="col-sm-5">Pagos en staging</dt>
                    <dd class="col-sm-7">
                        @Model.TotalPagosStaging.ToString("N0")
                    </dd>

                    <dt class="col-sm-5">Aplicaciones en staging</dt>
                    <dd class="col-sm-7">
                        @Model.TotalAplicacionesStaging.ToString("N0")
                    </dd>

                    <dt class="col-sm-5">Pagos omitidos</dt>
                    <dd class="col-sm-7">
                        @Model.TotalPagosOmitidos.ToString("N0")
                    </dd>

                    <dt class="col-sm-5">Aplicaciones omitidas</dt>
                    <dd class="col-sm-7">
                        @Model.TotalAplicacionesOmitidas.ToString("N0")
                    </dd>

                    <dt class="col-sm-5">Valor total aplicado</dt>
                    <dd class="col-sm-7">
                        @Model.ValorTotalAplicadoImportado.ToString("C0")
                    </dd>

                    <dt class="col-sm-5">Valor total en anticipo</dt>
                    <dd class="col-sm-7">
                        @Model.ValorTotalAnticipoImportado.ToString("C0")
                    </dd>

                    <dt class="col-sm-5">Procesado por</dt>
                    <dd class="col-sm-7">@Model.ProcesadoPor</dd>

                    <dt class="col-sm-5">Finalización UTC</dt>
                    <dd class="col-sm-7">
                        @(Model.FechaFinalizacionUtc.ToString(
                            "yyyy-MM-dd HH:mm:ss 'UTC'"))
                    </dd>
                </dl>
            </div>
        </div>

        <div class="mt-4">
            <a asp-controller="Importacion"
               asp-action="Index"
               class="btn btn-primary">
                Volver a importaciones
            </a>
        </div>
    </div>
</div>
