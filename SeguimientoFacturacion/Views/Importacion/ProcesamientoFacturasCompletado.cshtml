@model SeguimientoFacturacion.ViewModels.Importacion.ResultadoProcesamientoLoteFacturasViewModel

@{
    ViewData["Title"] = "Facturas importadas";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="alert alert-success" role="alert">
            <h1 class="h4 alert-heading">
                Procesamiento completado correctamente
            </h1>

            <p class="mb-0">
                Los pacientes y las facturas fueron trasladados
                a las tablas definitivas.
            </p>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="text-secondary small">
                            Facturas importadas
                        </div>

                        <div class="fs-4 fw-semibold">
                            @Model.TotalFacturasImportadas.ToString("N0")
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="text-secondary small">
                            Pacientes nuevos
                        </div>

                        <div class="fs-4 fw-semibold">
                            @Model.TotalPacientesNuevos.ToString("N0")
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="text-secondary small">
                            Pacientes existentes
                        </div>

                        <div class="fs-4 fw-semibold">
                            @Model.TotalPacientesExistentes.ToString("N0")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">
                    Resultado definitivo
                </h2>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Lote</dt>
                    <dd class="col-sm-7"><code>@Model.LoteId</code></dd>

                    <dt class="col-sm-5">Estado</dt>
                    <dd class="col-sm-7">@Model.Estado</dd>

                    <dt class="col-sm-5">Procesado por</dt>
                    <dd class="col-sm-7">@Model.ProcesadoPor</dd>

                    <dt class="col-sm-5">Finalización UTC</dt>
                    <dd class="col-sm-7">
                        @(Model.FechaFinalizacionUtc.ToString(
                            "yyyy-MM-dd HH:mm:ss 'UTC'"))
                    </dd>
                </dl>
            </div>
        </div>

        <div class="mt-4">
            <a asp-controller="Importacion"
               asp-action="Index"
               class="btn btn-primary">
                Volver a importaciones
            </a>
        </div>
    </div>
</div>
