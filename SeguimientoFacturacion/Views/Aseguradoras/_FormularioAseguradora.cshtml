@model AseguradoraFormularioViewModel

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger"
     role="alert">
</div>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <label asp-for="Codigo" class="form-label"></label>
        <input asp-for="Codigo"
               class="form-control"
               readonly
               autocomplete="off" />
        <span asp-validation-for="Codigo"
              class="text-danger"></span>

        <div class="form-text">
            El sistema asigna automáticamente el mayor código existente
            más uno. Este valor no puede modificarse.
        </div>
    </div>

    <div class="col-12 col-md-8">
        <label asp-for="Descripcion" class="form-label"></label>
        <input asp-for="Descripcion"
               class="form-control"
               autocomplete="off" />
        <span asp-validation-for="Descripcion"
              class="text-danger"></span>
    </div>
</div>
