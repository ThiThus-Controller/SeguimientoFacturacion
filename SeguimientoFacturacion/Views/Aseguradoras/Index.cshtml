@model AseguradoraListadoViewModel

@{
    ViewData["Title"] = "Administración de aseguradoras";

    var puedeCrear =
        User.TienePermiso(PermisosSistema.Aseguradoras.Crear);

    var puedeEditar =
        User.TienePermiso(PermisosSistema.Aseguradoras.Editar);

    var puedeCambiarEstado =
        User.TienePermiso(PermisosSistema.Aseguradoras.Inactivar);
}

<div class="d-flex flex-wrap justify-content-between
            align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Administración de aseguradoras</h1>
        <p class="text-muted mb-0">
            Gestione las entidades disponibles para facturación.
        </p>
    </div>

    @if (puedeCrear)
    {
        <a asp-action="Crear" class="btn btn-primary">
            Crear aseguradora
        </a>
    }
</div>

@if (ViewData["MensajeExito"] is string mensajeExito)
{
    <div class="alert alert-success" role="alert">
        @mensajeExito
    </div>
}

@if (ViewData["MensajeError"] is string mensajeError)
{
    <div class="alert alert-danger" role="alert">
        @mensajeError
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <strong>Aseguradoras registradas</strong>
        <span class="badge text-bg-secondary ms-2">
            @Model.Aseguradoras.Count
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Auditoría</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Aseguradoras.Count == 0)
                {
                    <tr>
                        <td colspan="5"
                            class="text-center text-muted py-4">
                            No hay aseguradoras registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var aseguradora in Model.Aseguradoras)
                    {
                        <tr>
                            <td>
                                <strong>@aseguradora.Codigo</strong>
                            </td>
                            <td>@aseguradora.Descripcion</td>
                            <td>
                                @if (aseguradora.Activo)
                                {
                                    <span class="badge text-bg-success">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">
                                        Inactiva
                                    </span>
                                }
                            </td>
                            <td class="small">
                                @if (aseguradora.FechaModificacionUtc.HasValue)
                                {
                                    <span>
                                        Modificada por
                                        <strong>@aseguradora.ModificadoPor</strong>
                                    </span>
                                    <br />
                                    <span class="text-muted">
                                        @aseguradora.FechaModificacionUtc.Value.ToString("yyyy-MM-dd HH:mm 'UTC'")
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Creada por
                                        <strong>@aseguradora.CreadoPor</strong>
                                    </span>
                                    <br />
                                    <span class="text-muted">
                                        @aseguradora.FechaCreacionUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap
                                            justify-content-end gap-1">
                                    @if (puedeEditar)
                                    {
                                        <a asp-action="Editar"
                                           asp-route-codigo="@aseguradora.Codigo"
                                           class="btn btn-sm
                                                  btn-outline-primary">
                                            Editar
                                        </a>
                                    }

                                    @if (puedeCambiarEstado)
                                    {
                                        @if (aseguradora.Activo)
                                        {
                                            <form asp-action="Inactivar"
                                                  asp-route-codigo="@aseguradora.Codigo"
                                                  method="post"
                                                  class="d-inline">
                                                <button type="submit"
                                                        class="btn btn-sm
                                                        btn-outline-danger">
                                                    Inactivar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Activar"
                                                  asp-route-codigo="@aseguradora.Codigo"
                                                  method="post"
                                                  class="d-inline">
                                                <button type="submit"
                                                        class="btn btn-sm
                                                        btn-outline-success">
                                                    Activar
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
