@using Microsoft.AspNetCore.Authorization
@using SeguimientoFacturacion.Configurations
@inject IAuthorizationService ServicioAutorizacion

@{
    var puedeImportar =
        User.Identity?.IsAuthenticated == true &&
        (await ServicioAutorizacion.AuthorizeAsync(
            User,
            PoliticasAutorizacion.ImportacionesAcceder))
        .Succeeded;

    var puedeAdministrarUsuarios =
        User.Identity?.IsAuthenticated == true &&
        (await ServicioAutorizacion.AuthorizeAsync(
            User,
            PoliticasAutorizacion.UsuariosConsultar))
        .Succeeded;

    var puedeAdministrarFacturadores =
        User.Identity?.IsAuthenticated == true &&
        (await ServicioAutorizacion.AuthorizeAsync(
            User,
            PoliticasAutorizacion.FacturadoresConsultar))
        .Succeeded;

    var puedeAdministrarAseguradoras =
        User.Identity?.IsAuthenticated == true &&
        (await ServicioAutorizacion.AuthorizeAsync(
            User,
            PoliticasAutorizacion.AseguradorasConsultar))
        .Succeeded;

    var puedeConsultarFacturas =
        User.Identity?.IsAuthenticated == true &&
        (await ServicioAutorizacion.AuthorizeAsync(
            User,
            PoliticasAutorizacion.FacturasConsultar))
        .Succeeded;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - SeguimientoFacturacion
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SeguimientoFacturacion.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light
            bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    SeguimientoFacturacion
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarPrincipal"
                        aria-expanded="false"
                        aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="navbarPrincipal"
                     class="navbar-collapse collapse
                    d-sm-inline-flex
                    justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        @if (puedeImportar)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Importacion"
                                   asp-action="Index">
                                    Analizar importación
                                </a>
                            </li>
                        }

                        @if (puedeConsultarFacturas)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Facturas"
                                   asp-action="Index">
                                    Facturas
                                </a>
                            </li>
                        }

                        @if (puedeAdministrarUsuarios)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Usuarios"
                                   asp-action="Index">
                                    Usuarios
                                </a>
                            </li>
                        }

                        @if (puedeAdministrarFacturadores)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Facturadores"
                                   asp-action="Index">
                                    Facturadores
                                </a>
                            </li>
                        }

                        @if (puedeAdministrarAseguradoras)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Aseguradoras"
                                   asp-action="Index">
                                    Aseguradoras
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacidad
                            </a>
                        </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-sm-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="navbar-text me-sm-3">
                                    @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Cuenta"
                                      asp-action="CerrarSesion"
                                      method="post">
                                    <button type="submit"
                                            class="btn btn-link nav-link text-dark">
                                        Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Cuenta"
                                   asp-action="IniciarSesion">
                                    Iniciar sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SeguimientoFacturacion - Departamento de sistemas
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)
</body>
</html>
