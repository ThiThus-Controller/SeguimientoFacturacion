@model SeguimientoFacturacion.ViewModels.Seguridad.InicioSesionViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
        <div class="card shadow-sm login-card">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h1 class="h3 mb-2">SeguimientoFacturacion</h1>
                    <p class="text-muted mb-0">
                        Ingrese con su cuenta autorizada.
                    </p>
                </div>

                <form asp-controller="Cuenta"
                      asp-action="IniciarSesion"
                      method="post"
                      autocomplete="on">
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div class="mb-3">
                        <label asp-for="NombreUsuario"
                               class="form-label">
                        </label>

                        <input asp-for="NombreUsuario"
                               class="form-control"
                               autocomplete="username"
                               autofocus />

                        <span asp-validation-for="NombreUsuario"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Contrasena"
                               class="form-label">
                        </label>

                        <input asp-for="Contrasena"
                               class="form-control"
                               autocomplete="current-password" />

                        <span asp-validation-for="Contrasena"
                              class="text-danger">
                        </span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Iniciar sesión
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
