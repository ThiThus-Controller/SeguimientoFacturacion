@model SeguimientoFacturacion.ViewModels.Glosas.GlosaAnulacionViewModel

@{
    ViewData["Title"] = "Anular glosa";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Anular glosa</h1>
    <p class="text-muted mb-0">
        Factura @Model.FacturaId · Estado actual: @Model.Estado
    </p>
</div>

@if (Model.TieneNotaCreditoVigente)
{
    <div class="alert alert-danger" role="alert">
        La glosa tiene una nota crédito vigente y no puede anularse.
        Primero debe resolverse la dependencia financiera.
    </div>

    <a asp-action="Index"
       asp-route-facturaId="@Model.FacturaId"
       class="btn btn-outline-secondary">
        Volver a las glosas
    </a>
}
else
{
    <div class="alert alert-warning" role="alert">
        La anulación conserva la trazabilidad del registro y exige un motivo.
        Esta operación no elimina físicamente la glosa.
    </div>

    <form asp-action="Anular"
          asp-route-glosaId="@Model.Id"
          method="post"
          class="card border-danger">
        <input asp-for="Id" type="hidden" />
        <input asp-for="FacturaId" type="hidden" />
        <input asp-for="VersionFilaBase64" type="hidden" />

        <div class="card-body">
            <div asp-validation-summary="All"
                 class="alert alert-danger"
                 role="alert"></div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">Fecha de glosa</label>
                    <input value="@Model.FechaGlosa.ToString("yyyy-MM-dd")"
                           class="form-control"
                           readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Valor glosado</label>
                    <input value="@Model.ValorGlosa.ToString("N2")"
                           class="form-control"
                           readonly />
                </div>
            </div>

            <div>
                <label asp-for="Observacion" class="form-label"></label>
                <textarea asp-for="Observacion"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Observacion"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-end gap-2">
            <a asp-action="Index"
               asp-route-facturaId="@Model.FacturaId"
               class="btn btn-outline-secondary">
                Cancelar
            </a>
            <button type="submit" class="btn btn-danger">
                Confirmar anulación
            </button>
        </div>
    </form>

}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
