@model SeguimientoFacturacion.ViewModels.Glosas.GlosaResolucionViewModel

@{
    ViewData["Title"] = "Resolver glosa";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Resolver glosa</h1>
    <p class="text-muted mb-0">
        Factura @Model.FacturaId · Estado actual: @Model.EstadoActual
    </p>
</div>

<div class="alert alert-info" role="alert">
    Una aceptación parcial conservará la glosa en negociación. Podrá
    ampliar posteriormente el valor aceptado y emitir otra nota crédito
    hasta completar ese nuevo cupo. La conciliación cierra a favor de la
    institución la diferencia no aceptada.
</div>

<form asp-action="Resolver"
      asp-route-glosaId="@Model.Id"
      method="post"
      class="card">
    <input asp-for="Id" type="hidden" />
    <input asp-for="FacturaId" type="hidden" />
    <input asp-for="VersionFilaBase64" type="hidden" />

    <div class="card-body">
        <div asp-validation-summary="All"
             class="alert alert-danger"
             role="alert"></div>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <label class="form-label">Fecha de glosa</label>
                <input value="@Model.FechaGlosa.ToString("yyyy-MM-dd")"
                       class="form-control"
                       readonly />
            </div>
            <div class="col-md-3">
                <label class="form-label">Valor glosado</label>
                <input value="@Model.ValorGlosa.ToString("N2")"
                       class="form-control"
                       readonly />
            </div>
            <div class="col-md-3">
                <label asp-for="EstadoFinal" class="form-label"></label>
                <select asp-for="EstadoFinal" class="form-select">
                    <option value="@((int)EstadoGlosa.Aceptada)">
                        Aceptada
                    </option>
                    @if (Model.ValorAceptado == decimal.Zero)
                    {
                        <option value="@((int)EstadoGlosa.Levantada)">
                            Levantada
                        </option>
                    }
                </select>
                <span asp-validation-for="EstadoFinal"
                      class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="FechaRespuesta" class="form-label"></label>
                <input asp-for="FechaRespuesta" class="form-control" />
                <span asp-validation-for="FechaRespuesta"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="ValorAceptado" class="form-label"></label>
                <input asp-for="ValorAceptado"
                       class="form-control"
                       inputmode="decimal"
                       data-decimal-flexible="true" />
                <span asp-validation-for="ValorAceptado"
                      class="text-danger"></span>
                @if (Model.ValorAceptado > decimal.Zero)
                {
                    <div class="form-text">
                        Valor aceptado acumulado actual:
                        @Model.ValorAceptado.ToString("N2"). No puede disminuirse.
                    </div>
                }
            </div>
            <div class="col-md-8">
                <label asp-for="Observacion" class="form-label"></label>
                <textarea asp-for="Observacion"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Observacion"
                      class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index"
           asp-route-facturaId="@Model.FacturaId"
           class="btn btn-outline-secondary">
            Cancelar
        </a>
        <button type="submit" class="btn btn-primary">
            Guardar resolución
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
