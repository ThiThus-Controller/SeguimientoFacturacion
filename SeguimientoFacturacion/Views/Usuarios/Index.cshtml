@model UsuarioListadoViewModel

@{
    ViewData["Title"] = "Administración de usuarios";

    var puedeCrear =
        User.TienePermiso(PermisosSistema.Usuarios.Crear) &&
        User.TienePermiso(PermisosSistema.Usuarios.AsignarRoles) &&
        User.TienePermiso(PermisosSistema.Usuarios.AsignarPermisos);

    var puedeEditar =
        User.TienePermiso(PermisosSistema.Usuarios.Editar) &&
        User.TienePermiso(PermisosSistema.Usuarios.AsignarRoles) &&
        User.TienePermiso(PermisosSistema.Usuarios.AsignarPermisos);

    var puedeCambiarEstado =
        User.TienePermiso(PermisosSistema.Usuarios.Inactivar);

    var puedeRestablecer =
        User.TienePermiso(
            PermisosSistema.Usuarios.RestablecerClave);
}

<div class="d-flex flex-wrap justify-content-between
            align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Administración de usuarios</h1>
        <p class="text-muted mb-0">
            Gestione cuentas, roles, permisos y estado de acceso.
        </p>
    </div>

    @if (puedeCrear)
    {
        <a asp-action="Crear" class="btn btn-primary">
            Crear usuario
        </a>
    }
</div>

@if (ViewData["MensajeExito"] is string mensajeExito)
{
    <div class="alert alert-success" role="alert">
        @mensajeExito
    </div>
}

@if (ViewData["MensajeError"] is string mensajeError)
{
    <div class="alert alert-danger" role="alert">
        @mensajeError
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <strong>Usuarios registrados</strong>
        <span class="badge text-bg-secondary ms-2">
            @Model.Usuarios.Count
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Usuario</th>
                    <th>Nombre completo</th>
                    <th>Roles</th>
                    <th>Estado</th>
                    <th>Versión</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Usuarios.Count == 0)
                {
                    <tr>
                        <td colspan="6"
                            class="text-center text-muted py-4">
                            No hay usuarios registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var usuario in Model.Usuarios)
                    {
                        <tr>
                            <td>
                                <strong>@usuario.NombreUsuario</strong>
                            </td>
                            <td>@usuario.NombreCompleto</td>
                            <td>
                                @foreach (var rol in usuario.Roles)
                                {
                                    <span class="badge text-bg-light
                                                 border me-1 mb-1">
                                        @rol
                                    </span>
                                }
                            </td>
                            <td>
                                @if (usuario.Activo)
                                {
                                    <span class="badge text-bg-success">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">
                                        Inactivo
                                    </span>
                                }
                            </td>
                            <td>@usuario.VersionSeguridad</td>
                            <td>
                                <div class="d-flex flex-wrap
                                            justify-content-end gap-1">
                                    @if (puedeEditar)
                                    {
                                        <a asp-action="Editar"
                                           asp-route-usuarioId="@usuario.Id"
                                           class="btn btn-sm
                                                  btn-outline-primary">
                                            Editar
                                        </a>
                                    }

                                    @if (puedeRestablecer)
                                    {
                                        <a asp-action="RestablecerContrasena"
                                           asp-route-usuarioId="@usuario.Id"
                                           class="btn btn-sm
                                                  btn-outline-warning">
                                            Contraseña
                                        </a>
                                    }

                                    @if (puedeCambiarEstado &&
                                         !string.Equals(
                                             usuario.NombreUsuario,
                                             User.Identity?.Name,
                                             StringComparison.OrdinalIgnoreCase))
                                    {
                                        @if (usuario.Activo)
                                        {
                                            <form asp-action="Inactivar"
                                                  asp-route-usuarioId="@usuario.Id"
                                                  method="post"
                                                  class="d-inline">
                                                <button type="submit"
                                                        class="btn btn-sm
                                                        btn-outline-danger">
                                                    Inactivar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Activar"
                                                  asp-route-usuarioId="@usuario.Id"
                                                  method="post"
                                                  class="d-inline">
                                                <button type="submit"
                                                        class="btn btn-sm
                                                        btn-outline-success">
                                                    Activar
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
