@model FacturadorFormularioViewModel

@{
    ViewData["Title"] = "Editar facturador";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Editar facturador</h1>
    <p class="text-muted mb-0">
        Actualice el nombre conservando el código empresarial.
    </p>
</div>

<form asp-action="Editar"
      asp-route-codigo="@Model.Codigo"
      method="post"
      autocomplete="off">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <partial name="_FormularioFacturador" model="Model" />
        </div>
        <div class="card-footer bg-white d-flex gap-2
                    justify-content-end">
            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancelar
            </a>
            <button type="submit" class="btn btn-primary">
                Guardar cambios
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
